PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/wacrm?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_API_SECRET=replace-with-a-long-random-internal-secret
CLIENT_URL=http://localhost:3000
NODE_ENV=development
# Set in production only, e.g. .ciisnetwork.com, so frontend/backend subdomains share auth cookies.
# Leave unset for localhost development.
# COOKIE_DOMAIN=.ciisnetwork.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
EMAIL_FROM=your-sender@gmail.com
